<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" spacing="10" alignment="CENTER" stylesheets="@styles.css" styleClass="root">
    <VBox spacing="10" alignment="CENTER" styleClass="card">
        <Label text="Inscription" styleClass="title"/>

        <Label text="Nom" styleClass="label"/>
        <TextField fx:id="nameField" promptText="Entrez votre nom" styleClass="input"/>

        <Label text="Email" styleClass="label"/>
        <TextField fx:id="emailField" promptText="Entrez votre email" styleClass="input"/>

        <Label text="Mot de passe" styleClass="label"/>
        <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" styleClass="input"/>

        <Button text="S'inscrire" fx:id="signupButton" defaultButton="true" styleClass="button-primary"/>

        <Label text="Vous avez déjà un compte ?" styleClass="info-label"/>
        <Button text="Se connecter" fx:id="loginButton" styleClass="button-secondary"/>
    </VBox>
</VBox>